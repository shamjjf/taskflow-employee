# ─── Backend API URLs ─────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.example.com/api
NEXT_PUBLIC_SOCKET_URL=https://api.example.com

# ─── Agora (video/audio calls) ────────────────────────────────────────────
# App ID is safe to ship to the browser.
# Do NOT put AGORA_APP_CERTIFICATE here — that is a server-side secret
# and must only live in the backend `.env`.
NEXT_PUBLIC_AGORA_APP_ID=
